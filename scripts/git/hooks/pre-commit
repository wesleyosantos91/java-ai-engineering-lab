#!/usr/bin/env bash
# Hook pre-commit: branch de trabalho, configuração de agentes, espaços no diff preparado e,
# quando disponível, varredura de segredos. Instale com bash scripts/git/install-hooks.sh.
set -Eeuo pipefail
ROOT_DIR="$(git rev-parse --show-toplevel)"

bash "${ROOT_DIR}/scripts/git/guard-branch.sh"
bash "${ROOT_DIR}/scripts/agents/check-config.sh" >/dev/null || {
  echo "[FAIL] pre-commit: configuração de agentes inválida; execute bash scripts/agents/check-config.sh." >&2
  exit 1
}
git -C "${ROOT_DIR}" diff --cached --check || {
  echo "[FAIL] pre-commit: espaços em branco inválidos no diff preparado." >&2
  exit 1
}

# Varredura de segredos: SKIP (3) não bloqueia, mas é informado; achados (1) bloqueiam.
code=0
bash "${ROOT_DIR}/scripts/security/scan-secrets.sh" --staged || code=$?
case "${code}" in
  0|3) ;;
  *) echo "[FAIL] pre-commit: varredura de segredos reprovou o commit." >&2; exit 1 ;;
esac

# .github/ é gerido pelo time de DevOps (AGENTS.md, seção 8). O hook não bloqueia, porque o próprio
# time faz commits nesse diretório, mas deixa a alteração visível para quem (pessoa ou agente) commita.
github_changes="$(git -C "${ROOT_DIR}" diff --cached --name-only -- .github | head -n 5)"
if [[ -n "${github_changes}" ]]; then
  echo "[AVISO] pre-commit: o commit altera .github/, gerido pelo time de DevOps (AGENTS.md, seção 8):" >&2
  printf '  - %s\n' ${github_changes} >&2
  echo "        Agentes não alteram .github/; confirme que a mudança é do time responsável." >&2
fi
