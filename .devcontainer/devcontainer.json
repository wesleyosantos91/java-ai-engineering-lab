// Ambiente reproduzível para Codespaces, agentes em nuvem e desenvolvimento local em contêiner.
// Mesma stack do AGENTS.md: Java 27 (Temurin, patch fixado; atualize deliberadamente, LL-0009),
// Docker para Testcontainers e GitHub CLI.
// k6 não é instalado: o smoke de performance é execução explícita e opcional.
{
  "name": "java-ai-engineering-lab",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.9-ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1.8.3": {
      "version": "27.0.1.1+4",
      "jdkDistro": "tem",
      "installMaven": "false"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "postCreateCommand": "bash scripts/setup.sh && bash scripts/git/install-hooks.sh",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "editorconfig.editorconfig"]
    }
  },
  "remoteUser": "vscode"
}
